<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>일본어 회화 동화로 표현하기 프로젝트(수행평가)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Pretendard', sans-serif; background-color: #f3f4f6; }
        .japanese-font { font-family: 'Zen Maru Gothic', sans-serif; }
        .flip-card { perspective: 1000px; cursor: pointer; }
        .flip-card-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.6s; transform-style: preserve-3d; }
        .flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }
        .flip-card-front, .flip-card-back { position: absolute; width: 100%; height: 100%; -webkit-backface-visibility: hidden; backface-visibility: hidden; }
        .flip-card-back { transform: rotateY(180deg); }
        .animate-fade-in { animation: fadeIn 0.5s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // ★ 여기에 나중에 구글 앱스 스크립트 웹앱 주소를 넣으시면 됩니다!
        const GAS_URL = "https://script.google.com/macros/s/AKfycbw6ae0ULm4jWOkDZchChoX9Od7w_SlL07bdFLiBSwjRmIWS9cFXsen4jb415okhL6GpKw/exec";

        // ==========================================
        // 📚 학습 데이터 
        // ==========================================
        const wordsData = [
            { ko: "만들다", jp: "つくる [츠쿠루]" },
            { ko: "무엇, 뭐", jp: "なに [나니]" },
            { ko: "~(으)로 (수단, 재료)", jp: "で [데]" },
            { ko: "~은, 는", jp: "は [와]" },
            { ko: "~이, 가", jp: "が [가]" },
            { ko: "흙", jp: "つち [츠치]" },
            { ko: "뱀", jp: "へび [헤비]" },
            { ko: "항아리", jp: "つぼ [츠보]" },
            { ko: "술", jp: "さけ [사케]" },
            { ko: "친구", jp: "ともだち [토모다치]" },
            { ko: "염소", jp: "やぎ [야기]" },
            { ko: "가죽", jp: "かわ(革) [카와]" },
            { ko: "북", jp: "たいこ [타이코]" },
            { ko: "리듬", jp: "リズム [리즈무]" },
            { ko: "축제", jp: "まつり [마츠리]" },
            { ko: "솜", jp: "わた [와타]" },
            { ko: "실", jp: "いと [이토]" },
            { ko: "천", jp: "ぬの [누노]" },
            { ko: "옷", jp: "きもの [키모노]" },
            { ko: "허수아비", jp: "かかし [카카시]" },
            { ko: "돌", jp: "いし [이시]" },
            { ko: "철", jp: "てつ [테츠]" },
            { ko: "가위", jp: "はさみ [하사미]" },
            { ko: "오린 것", jp: "きりぬき [키리누키]" },
            { ko: "그림책", jp: "えほん [에홍]" },
            { ko: "물", jp: "みず [미즈]" },
            { ko: "강", jp: "かわ(川) [카와]" },
            { ko: "댐", jp: "ダム [다무]" },
            { ko: "전기", jp: "でんき [뎅키]" },
            { ko: "빛, 등불", jp: "あかり [아카리]" },
            { ko: "해님", jp: "おひさま [오히사마]" },
            { ko: "채소", jp: "やさい [야사이]" },
            { ko: "샐러드", jp: "サラダ [사라다]" },
            { ko: "몸", jp: "からだ [카라다]" },
            { ko: "기록", jp: "きろく [키로쿠]" },
            { ko: "성냥", jp: "マッチ [맛치]" },
            { ko: "불", jp: "ひ [히]" },
            { ko: "모닥불", jp: "たきび [타키비]" },
            { ko: "군고구마", jp: "やきいも [야키이모]" },
            { ko: "방귀", jp: "おなら [오나라]" },
            { ko: "나무", jp: "き [키]" },
            { ko: "통나무", jp: "まるた [마루타]" },
            { ko: "다리", jp: "はし [하시]" },
            { ko: "길", jp: "みち [미치]" },
            { ko: "마을, 동네", jp: "まち [마치]" },
            { ko: "닭", jp: "にわとり [니와토리]" },
            { ko: "달걀", jp: "たまご [타마고]" },
            { ko: "닭꼬치", jp: "やきとり [야키토리]" },
            { ko: "돈", jp: "おかね [오카네]" },
            { ko: "사람", jp: "ひと [히토]" },
            { ko: "병사", jp: "へいたい [헤이타이]" },
            { ko: "군대", jp: "ぐんたい [군타이]" },
            { ko: "전쟁", jp: "せんそう [센소-]" }
        ];

        const standardSentences = [
            { ko: "흙으로 무엇을 만들어? / 항아리 만들어.", jp: "つちで なに つくる？ [츠치데 나니 츠쿠루?] / つぼ つくる。 [츠보 츠쿠루.]" },
            { ko: "뱀으로 무엇을 만들어? / 뱀으로 항아리 만들어.", jp: "へびで なに つくる？ [헤비데 나니 츠쿠루?] / へびで つぼ つくる。 [헤비데 츠보 츠쿠루.]" },
            { ko: "항아리로 무엇을 만들어? / 항아리로 술 만들어.", jp: "つぼで なに つくる？ [츠보데 나니 츠쿠루?] / つぼで さけ つくる。 [츠보데 사케 츠쿠루.]" },
            { ko: "술은 무엇 만들어? / 술은 친구 만들어.", jp: "さけは なに つくる？ [사케와 나니 츠쿠루?] / さけは ともだち つくる。 [사케와 토모다치 츠쿠루.]" },
            { ko: "염소로 무엇 만들어? / 염소로 가죽 만들어.", jp: "やぎで なに つくる？ [야기데 나니 츠쿠루?] / やぎで かわ つくる。 [야기데 카와 츠쿠루.]" },
            { ko: "가죽으로 무엇 만들어? / 가죽으로 북 만들어.", jp: "かわで なに つくる？ [카와데 나니 츠쿠루?] / かわで たいこ つくる。 [카와데 타이코 츠쿠루.]" },
            { ko: "북으로 무엇 만들어? / 북으로 리듬 만들어.", jp: "たいこで なに つくる？ [타이코데 나니 츠쿠루?] / たいこで リズム つくる。 [타이코데 리즈무 츠쿠루.]" },
            { ko: "리듬은 무엇 만들어? / 리듬은 축제 만들어.", jp: "リズムは なに つくる？ [리즈무와 나니 츠쿠루?] / リズムは まつり つくる。 [리즈무와 마츠리 츠쿠루.]" },
            { ko: "솜으로 무엇 만들어? / 솜으로 실 만들어.", jp: "わたで なに つくる？ [와타데 나니 츠쿠루?] / わたで いと つくる。 [와타데 이토 츠쿠루.]" },
            { ko: "실로 무엇 만들어? / 실로 천 만들어.", jp: "いとで なに つくる？ [이토데 나니 츠쿠루?] / いとで ぬの つくる。 [이토데 누노 츠쿠루.]" },
            { ko: "천으로 옷 만들어.", jp: "ぬので きもの つくる。 [누노데 키모노 츠쿠루.]" },
            { ko: "옷으로 무엇 만들어? / 옷으로 허수아비 만들어.", jp: "きもので なに つくる？ [키모노데 나니 츠쿠루?] / きもので かかし つくる。 [키모노데 카카시 츠쿠루.]" },
            { ko: "돌로 무엇 만들어? / 돌로 철 만들어.", jp: "いしで なに つくる？ [이시데 나니 츠쿠루?] / いしで てつ つくる。 [이시데 테츠 츠쿠루.]" },
            { ko: "철로 무엇 만들어? / 철로 가위 만들어.", jp: "てつで なに つくる？ [테츠데 나니 츠쿠루?] / てつで はさみ つくる。 [테츠데 하사미 츠쿠루.]" },
            { ko: "가위로 무엇 만들어? / 가위로 오린 것 만들어.", jp: "はさみで なに つくる？ [하사미데 나니 츠쿠루?] / はさみで きりぬき つくる。 [하사미데 키리누키 츠쿠루.]" },
            { ko: "오린 것으로 무엇 만들어? / 오린 것으로 그림책 만들어.", jp: "きりぬきで なに つくる？ [키리누키데 나니 츠쿠루?] / きりぬきで えほん つくる。 [키리누키데 에홍 츠쿠루.]" },
            { ko: "물은 무엇 만들어? / 물은 강 만들어.", jp: "みずは なに つくる？ [미즈와 나니 츠쿠루?] / みずは かわ つくる。 [미즈와 카와 츠쿠루.]" },
            { ko: "강으로 무엇 만들어? / 강으로 댐 만들어.", jp: "かわで なに つくる？ [카와데 나니 츠쿠루?] / かわで ダム つくる。 [카와데 다무 츠쿠루.]" },
            { ko: "댐으로 무엇 만들어? / 댐으로 전기 만들어.", jp: "ダムで なに つくる？ [다무데 나니 츠쿠루?] / ダムで でんき つくる。 [다무데 뎅키 츠쿠루.]" },
            { ko: "전기가 무엇 만들어? / 전기가 빛 만들어.", jp: "でんきが なに つくる？ [뎅키가 나니 츠쿠루?] / でんきが あかり つくる。 [뎅키가 아카리 츠쿠루.]" },
            { ko: "해님은 무엇 만들어? / 해님은 채소 만들어.", jp: "おひさまは なに つくる？ [오히사마와 나니 츠쿠루?] / おひさまは やさい つくる。 [오히사마와 야사이 츠쿠루.]" },
            { ko: "채소로 무엇 만들어? / 채소로 샐러드 만들어.", jp: "やさいで なに つくる？ [야사이데 나니 츠쿠루?] / やさいで サラダ つくる。 [야사이데 사라다 츠쿠루.]" },
            { ko: "샐러드는 무엇 만들어? / 샐러드는 몸 만들어.", jp: "サラダは なに つくる？ [사라다와 나니 츠쿠루?] / サラダは からだ つくる。 [사라다와 카라다 츠쿠루.]" },
            { ko: "몸으로 무엇 만들어? / 몸으로 기록 만들어.", jp: "からだで なに つくる？ [카라다데 나니 츠쿠루?] / からだで きろく つくる。 [카라다데 키로쿠 츠쿠루.]" },
            { ko: "성냥으로 무엇 만들어? / 성냥으로 불을 만들어.", jp: "マッチで なに つくる？ [맛치데 나니 츠쿠루?] / マッチで ひを つくる。 [맛치데 히오 츠쿠루.]" },
            { ko: "불로 무엇 만들어? / 불로 모닥불 만들어.", jp: "ひで なに つくる？ [히데 나니 츠쿠루?] / ひで たきび つくる。 [히데 타키비 츠쿠루.]" },
            { ko: "모닥불로 무엇 만들어? / 모닥불로 군고구마 만들어.", jp: "たきびで なに つくる？ [타키비데 나니 츠쿠루?] / たきびで やきいも つくる。 [타키비데 야키이모 츠쿠루.]" },
            { ko: "군고구마는 무엇 만들어? / 군고구마는 방귀 만들어.", jp: "やきいもは なに つくる？ [야키이모와 나니 츠쿠루?] / やきいもは おなら つくる。 [야키이모와 오나라 츠쿠루.]" },
            { ko: "나무로 무엇 만들어? / 나무로 통나무 만들어.", jp: "きで なに つくる？ [키데 나니 츠쿠루?] / きで まるた つくる。 [키데 마루타 츠쿠루.]" },
            { ko: "통나무로 무엇 만들어? / 통나무로 다리 만들어.", jp: "まるたで なに つくる？ [마루타데 나니 츠쿠루?] / まるたで はし つくる。 [마루타데 하시 츠쿠루.]" },
            { ko: "다리로 무엇 만들어? / 다리로 길 만들어.", jp: "はしで なに つくる？ [하시데 나니 츠쿠루?] / はしで みち つくる。 [하시데 미치 츠쿠루.]" },
            { ko: "길은 무엇 만들어? / 길은 마을 만들어.", jp: "みちは なに つくる？ [미치와 나니 츠쿠루?] / みちは まち つくる。 [미치와 마치 츠쿠루.]" },
            { ko: "닭은 무엇 만들어? / 닭은 달걀 만들어.", jp: "にわとりは なに つくる？ [니와토리와 나니 츠쿠루?] / にわとりは たまご つくる。 [니와토리와 타마고 츠쿠루.]" },
            { ko: "달걀은 무엇 만들어? / 달걀은 닭 만들어.", jp: "たまごは なに つくる？ [타마고와 나니 츠쿠루?] / たまごは にわとり つくる。 [타마고와 니와토리 츠쿠루.]" },
            { ko: "닭으로 무엇 만들어? / 닭으로 닭꼬치 만들어.", jp: "にわとりで なに つくる？ [니와토리데 나니 츠쿠루?] / にわとりで やきとり つくる。 [니와토리데 야키토리 츠쿠루.]" },
            { ko: "닭꼬치는 무엇 만들어? / 닭꼬치는 돈 만들어.", jp: "やきとりは なに つくる？ [야키토리와 나니 츠쿠루?] / やきとりは おかね つくる。 [야키토리와 오카네 츠쿠루.]" },
            { ko: "사람으로 무엇 만들어? / 사람으로 병사 만들어.", jp: "ひとで なに つくる？ [히토데 나니 츠쿠루?] / ひとで へいたい つくる。 [히토데 헤이타이 츠쿠루.]" },
            { ko: "병사로 무엇 만들어? / 병사로 군대 만들어.", jp: "へいたいで なに つくる？ [헤이타이데 나니 츠쿠루?] / へいたいで ぐんたい つくる。 [헤이타이데 군타이 츠쿠루.]" },
            { ko: "군대는 무엇 만들어? / 군대는 전쟁 만들어.", jp: "ぐんたいは なに つくる？ [군타이와 나니 츠쿠루?] / ぐんたいは せんそう つくる。 [군타이와 센소- 츠쿠루.]" },
            { ko: "전쟁은 무엇 만들어?", jp: "せんそうは なに つくる？ [센소-와 나니 츠쿠루?]" }
        ];

        // ==========================================
        // 🏠 메인 홈 화면
        // ==========================================
        function HomeScreen({ setScreen }) {
            return (
                <div className="flex flex-col items-center justify-center py-10 animate-fade-in px-4 h-full">
                    <div className="w-28 h-28 bg-indigo-100 rounded-full flex items-center justify-center mb-8 shadow-sm">
                        <i className="fa-solid fa-book-open text-6xl text-indigo-500"></i>
                    </div>
                    <h1 className="text-4xl font-black text-gray-800 mb-4 text-center break-keep-all">일본어 회화 동화로 표현하기</h1>
                    <p className="text-gray-500 mb-12 font-medium text-lg">수행평가 연습 및 채점 시스템</p>
                    
                    <div className="w-full max-w-2xl grid grid-cols-1 md:grid-cols-2 gap-4">
                        <button onClick={() => setScreen('practice')} className="group relative w-full flex justify-center items-center py-6 px-4 border border-transparent text-lg font-bold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-md transition-all">
                            <i className="fa-solid fa-headphones mr-3 text-xl"></i> 단어 및 문장 연습
                        </button>
                        <button onClick={() => setScreen('student-submit')} className="group relative w-full flex justify-center items-center py-6 px-4 border border-transparent text-lg font-bold rounded-xl text-indigo-700 bg-indigo-100 hover:bg-indigo-200 shadow-sm transition-all">
                            <i className="fa-solid fa-pen mr-3 text-xl"></i> 동화책 제출하기
                        </button>
                        <button onClick={() => setScreen('student-result')} className="group relative w-full flex justify-center items-center py-6 px-4 border border-indigo-200 text-lg font-bold rounded-xl text-indigo-600 bg-white hover:bg-gray-50 shadow-sm transition-all md:col-span-2">
                            <i className="fa-solid fa-chart-bar mr-3 text-xl"></i> 내 평가 결과 확인
                        </button>
                        
                        <div className="md:col-span-2 border-t border-gray-200 my-4"></div>
                        
                        <button onClick={() => setScreen('teacher-login')} className="group relative w-full flex justify-center items-center py-6 px-4 border border-transparent text-lg font-bold rounded-xl text-white bg-gray-800 hover:bg-gray-900 shadow-md transition-all md:col-span-2">
                            <i className="fa-solid fa-chalkboard-user mr-3 text-xl"></i> 교사 모드 (채점/대시보드)
                        </button>
                    </div>
                </div>
            );
        }

        // ==========================================
        // 🎧 학생 연습 화면
        // ==========================================
        function PracticeScreen({ setScreen, studentData }) {
            const [mode, setMode] = useState('words'); 
            const [flippedState, setFlippedState] = useState({});

            const toggleFlip = (idx) => {
                setFlippedState({ ...flippedState, [idx]: !flippedState[idx] });
            };

            const getList = () => {
                if (mode === 'words') return wordsData;
                if (mode === 'sentences') return standardSentences;
                return [];
            };

            return (
                <div className="flex flex-col h-[80vh]">
                    <div className="flex justify-between items-center mb-6">
                        <button onClick={() => setScreen('home')} className="text-gray-500 hover:text-gray-800"><i className="fa-solid fa-arrow-left text-xl"></i></button>
                        <h2 className="text-xl font-bold text-gray-800">연습 모드</h2>
                        <div className="w-5"></div>
                    </div>

                    <div className="flex bg-gray-200 rounded-lg p-1 mb-6">
                        <button onClick={() => setMode('words')} className={`flex-1 py-2 text-sm font-bold rounded-md transition ${mode === 'words' ? 'bg-white shadow text-indigo-600' : 'text-gray-500'}`}>단어 연습</button>
                        <button onClick={() => setMode('sentences')} className={`flex-1 py-2 text-sm font-bold rounded-md transition ${mode === 'sentences' ? 'bg-white shadow text-indigo-600' : 'text-gray-500'}`}>그림책 문장</button>
                    </div>

                    <div className="flex-1 overflow-y-auto pb-10">
                        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 px-2">
                            {getList().map((item, idx) => (
                                <div key={idx} className={`flip-card h-56 ${flippedState[idx] ? 'flipped' : ''}`} onClick={() => toggleFlip(idx)}>
                                    <div className="flip-card-inner shadow-md rounded-xl border border-gray-200">
                                        <div className="flip-card-front absolute w-full h-full bg-white rounded-xl flex flex-col items-center justify-center p-4">
                                            <div className="font-bold text-gray-800 text-[1.1rem] leading-relaxed w-full text-center">
                                                {item.ko.split('/').map((str, i) => (
                                                    <p key={i} className="mb-2 break-keep-all">{str.trim()}</p>
                                                ))}
                                            </div>
                                            <span className="absolute bottom-3 right-3 text-sm text-gray-400"><i className="fa-solid fa-hand-pointer"></i> 클릭하여 정답 확인</span>
                                        </div>
                                        <div className="flip-card-back absolute w-full h-full bg-indigo-50 rounded-xl flex flex-col items-center justify-center p-4 overflow-y-auto">
                                            <div className="w-full text-center japanese-font">
                                                {item.jp ? item.jp.split('/').map((str, i) => {
                                                    const parts = str.trim().split(' [');
                                                    const jpText = parts[0];
                                                    const pronunciation = parts.length > 1 ? '[' + parts[1] : '';
                                                    return (
                                                        <div key={i} className={`mb-4 ${i === item.jp.split('/').length - 1 ? 'mb-0' : 'border-b border-indigo-100 pb-3'}`}>
                                                            <p className="text-[1.2rem] font-black text-indigo-800 mb-1 leading-tight break-keep-all">{jpText}</p>
                                                            {pronunciation && <p className="text-[0.95rem] text-indigo-500 font-bold break-keep-all">{pronunciation}</p>}
                                                        </div>
                                                    )
                                                }) : <p className="font-bold text-indigo-700 text-[1.1rem]">"(학생 창작 문장)"</p>}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            );
        }

        // ==========================================
        // ✍️ 학생 동화책 제출 화면
        // ==========================================
        function StudentSubmitScreen({ setScreen, studentData, setStudentData }) {
            const [studentClass, setStudentClass] = useState('');
            const [studentId, setStudentId] = useState('');
            const [studentName, setStudentName] = useState('');
            const [sentences, setSentences] = useState([
                { ko: '' }, { ko: '' }, { ko: '' }, { ko: '' }
            ]);
            const [isSubmitting, setIsSubmitting] = useState(false);

            const classList = ['1반', '2반', '3반', '4반', '5반', '6반', '7반', '8반'];

            const handleSentenceChange = (index, value) => {
                const newSentences = [...sentences];
                newSentences[index].ko = value;
                setSentences(newSentences);
            };

            const handleSubmit = async (e) => {
                e.preventDefault();
                if (!studentClass || !studentId.trim() || !studentName.trim()) {
                    return alert("일본어 반, 학번, 이름을 모두 입력해주세요.");
                }
                for (let s of sentences) {
                    if (!s.ko.trim()) {
                        return alert("4문장의 한국어를 모두 입력해주세요.");
                    }
                }

                setIsSubmitting(true);
                const fullName = `${studentClass} ${studentId} ${studentName}`;

                const newStudentData = { ...studentData, [fullName]: sentences };
                setStudentData(newStudentData);

                // 여기에 추후 fetch()를 통해 GAS에 데이터를 전송하는 로직이 들어갑니다.
                setTimeout(() => {
                    alert("성공적으로 제출되었습니다!");
                    setScreen('home');
                    setIsSubmitting(false);
                }, 500);
            };

            return (
                <div className="flex flex-col py-4 max-h-[85vh] overflow-y-auto px-2">
                    <h2 className="text-2xl font-bold text-gray-800 mb-6 text-center">나의 동화책 제출하기</h2>
                    <form onSubmit={handleSubmit} className="flex flex-col gap-6">
                        <div className="flex gap-2">
                            <div className="flex-1">
                                <label className="block text-sm font-bold text-gray-700 mb-1">일본어 반</label>
                                <select value={studentClass} onChange={(e) => setStudentClass(e.target.value)} className="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none">
                                    <option value="">선택</option>
                                    {classList.map(c => <option key={c} value={c}>{c}</option>)}
                                </select>
                            </div>
                            <div className="flex-1">
                                <label className="block text-sm font-bold text-gray-700 mb-1">학번</label>
                                <input type="text" value={studentId} onChange={(e) => setStudentId(e.target.value)} placeholder="예: 10101" className="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none"/>
                            </div>
                            <div className="flex-1">
                                <label className="block text-sm font-bold text-gray-700 mb-1">이름</label>
                                <input type="text" value={studentName} onChange={(e) => setStudentName(e.target.value)} placeholder="예: 홍길동" className="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-blue-500 outline-none"/>
                            </div>
                        </div>

                        <div className="flex flex-col gap-4">
                            <p className="text-sm text-gray-500 font-bold mb-[-10px]"><i className="fa-solid fa-circle-info"></i> 창작한 동화책의 문장(한국어) 4개를 입력하세요.</p>
                            {sentences.map((s, idx) => (
                                <div key={idx} className="bg-blue-50 p-4 rounded-lg border border-blue-100">
                                    <h4 className="font-bold text-blue-800 mb-2">{idx + 1}번째 세트 (질문/답변)</h4>
                                    <input type="text" placeholder="예: 평화는 무엇을 만들어? / 친구를 만들어." value={s.ko} onChange={(e) => handleSentenceChange(idx, e.target.value)} className="w-full border border-gray-300 rounded p-2 text-sm"/>
                                </div>
                            ))}
                        </div>

                        <div className="flex gap-2">
                            <button type="button" onClick={() => setScreen('home')} className="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-3 rounded-lg shadow transition">취소</button>
                            <button type="submit" disabled={isSubmitting} className="flex-2 w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg shadow transition">
                                {isSubmitting ? '전송 중...' : '선생님께 제출하기'}
                            </button>
                        </div>
                    </form>
                </div>
            );
        }

        // ==========================================
        // 📊 학생 결과 확인 화면
        // ==========================================
        function StudentResultScreen({ setScreen, testScores }) {
            const [searchName, setSearchName] = useState('');
            const [result, setResult] = useState(null);
            const [searched, setSearched] = useState(false);

            const handleSearch = (e) => {
                e.preventDefault();
                setSearched(true);
                const foundKey = Object.keys(testScores).find(key => key.includes(searchName.trim()));
                if (foundKey) {
                    setResult({ name: foundKey, ...testScores[foundKey] });
                } else {
                    setResult(null);
                }
            };

            return (
                <div className="flex flex-col py-6 h-full">
                    <div className="flex items-center mb-8 relative">
                        <button onClick={() => setScreen('home')} className="absolute left-0 text-gray-500 hover:text-gray-800"><i className="fa-solid fa-arrow-left text-xl"></i></button>
                        <h2 className="text-2xl font-bold text-gray-800 w-full text-center">내 결과 확인</h2>
                    </div>

                    <form onSubmit={handleSearch} className="flex flex-col gap-4">
                        <p className="text-sm text-gray-600">선생님께 평가받은 자신의 이름(또는 학번)을 검색하세요.</p>
                        <input type="text" value={searchName} onChange={(e) => setSearchName(e.target.value)} placeholder="이름 입력 (예: 홍길동)" className="w-full border-2 border-indigo-200 rounded-xl p-3 focus:border-indigo-500 outline-none"/>
                        <button type="submit" className="bg-indigo-600 text-white font-bold py-3 rounded-xl">결과 조회</button>
                    </form>

                    {searched && (
                        <div className="mt-6 p-6 bg-gray-50 rounded-xl border text-center animate-fade-in w-full flex-1 overflow-y-auto">
                            {result !== null ? (
                                <>
                                    <p className="text-gray-600 mb-2 font-bold">{result.name} 학생의 채점 결과</p>
                                    <div className="text-5xl font-black text-orange-600 mb-6">{result.score} <span className="text-xl text-gray-400">/ {result.details.length} 점</span></div>
                                    <div className="text-left w-full bg-white p-4 rounded-lg border shadow-sm">
                                        <h4 className="font-bold text-gray-800 mb-4 border-b pb-2"><i className="fa-solid fa-list-check"></i> 상세 피드백 (틀린 부분 확인)</h4>
                                        {result.details.map((d, i) => (
                                            <div key={i} className="mb-4 last:mb-0 pb-4 border-b last:border-0 border-gray-100">
                                                <div className="flex items-center gap-2 mb-1">
                                                    <span className={`text-sm font-bold ${d.isCorrect ? 'text-green-500' : 'text-red-500'}`}>{d.isCorrect ? '[O 정답]' : '[X 오답]'}</span>
                                                    <span className={`text-xs px-2 py-0.5 rounded ${d.question.type.includes('기본') ? 'bg-blue-100 text-blue-700' : 'bg-pink-100 text-pink-700'}`}>{d.question.type}</span>
                                                </div>
                                                <div className="flex flex-wrap gap-1.5 mt-2 bg-gray-100 p-3 rounded-lg border border-gray-200">
                                                    {d.question.ko.split(/[\s/]+/).filter(w => w.trim() !== '').map((word, idx) => (
                                                        <span key={idx} className={`px-2 py-1 rounded-md text-sm shadow-sm transition-all ${d.errors[idx] ? 'text-white bg-red-500 line-through font-bold' : 'bg-white text-gray-700 border border-gray-200'}`}>{word}</span>
                                                    ))}
                                                </div>
                                                <div className="text-xs text-indigo-400 mt-2 pl-1">정답: {d.question.jp || "(학생 창작 문장입니다.)"}</div>
                                            </div>
                                        ))}
                                    </div>
                                </>
                            ) : (
                                <p className="text-red-500 font-bold">해당 이름의 평가 결과가 없거나<br/>아직 채점이 완료되지 않았습니다.</p>
                            )}
                        </div>
                    )}
                </div>
            );
        }

        // ==========================================
        // 🔒 교사 로그인, 메뉴, 대시보드 화면들
        // ==========================================
        function TeacherLoginScreen({ setScreen }) {
            const [password, setPassword] = useState('');
            const [error, setError] = useState('');

            const handleLogin = (e) => {
                e.preventDefault();
                if (password === '1207') {
                    setScreen('teacher-menu');
                } else {
                    setError('비밀번호가 일치하지 않습니다.');
                    setPassword('');
                }
            };

            return (
                <div className="flex flex-col items-center justify-center py-10 h-[70vh]">
                    <div className="w-20 h-20 bg-gray-800 rounded-full flex items-center justify-center mb-6 shadow-md"><i className="fa-solid fa-lock text-4xl text-white"></i></div>
                    <h2 className="text-2xl font-black text-gray-800 mb-6">교사 채점 모드</h2>
                    <form onSubmit={handleLogin} className="w-full max-w-sm">
                        <input type="password" placeholder="비밀번호 입력" value={password} onChange={(e) => setPassword(e.target.value)} className="w-full py-4 px-4 rounded-xl border border-gray-300 mb-4 focus:ring-2 focus:ring-gray-800 outline-none text-center tracking-[0.5em] text-lg font-bold"/>
                        {error && <p className="text-red-500 text-sm mb-4 font-bold text-center">{error}</p>}
                        <button type="submit" className="w-full bg-gray-800 hover:bg-gray-900 text-white font-bold py-4 rounded-xl shadow transition">입장하기</button>
                    </form>
                    <button onClick={() => setScreen('home')} className="mt-8 text-gray-500 hover:text-gray-800 font-bold underline">메인으로 돌아가기</button>
                </div>
            );
        }

        function TeacherMenuScreen({ setScreen }) {
            return (
                <div className="flex flex-col items-center justify-center py-10 animate-fade-in px-4 h-[70vh]">
                    <div className="w-20 h-20 bg-gray-800 rounded-full flex items-center justify-center mb-6 shadow-md"><i className="fa-solid fa-chalkboard-user text-4xl text-white"></i></div>
                    <h2 className="text-3xl font-black text-gray-800 mb-10 text-center">교사 메뉴</h2>
                    <div className="w-full max-w-md flex flex-col gap-4">
                        <button onClick={() => setScreen('test-setup')} className="w-full flex justify-center items-center py-5 px-4 text-xl font-bold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 shadow-md transition-all">
                            <i className="fa-solid fa-user-pen mr-3"></i> 학생 평가 시작하기
                        </button>
                        <button onClick={() => setScreen('teacher-dashboard')} className="w-full flex justify-center items-center py-5 px-4 text-xl font-bold rounded-xl text-gray-800 bg-gray-200 hover:bg-gray-300 shadow-sm transition-all">
                            <i className="fa-solid fa-list-ul mr-3"></i> 전체 학생 채점 결과 확인
                        </button>
                    </div>
                    <button onClick={() => setScreen('home')} className="mt-12 text-gray-500 hover:text-gray-800 font-bold underline">메인 화면으로 로그아웃</button>
                </div>
            );
        }

        function TeacherDashboardScreen({ setScreen, testScores }) {
            const scoresList = Object.entries(testScores);
            return (
                <div className="flex flex-col h-[80vh] animate-fade-in">
                    <div className="flex items-center mb-6 relative">
                        <button onClick={() => setScreen('teacher-menu')} className="absolute left-0 text-gray-500 hover:text-gray-800"><i className="fa-solid fa-arrow-left text-xl"></i></button>
                        <h2 className="text-2xl font-bold text-gray-800 w-full text-center">전체 학생 채점 결과</h2>
                    </div>
                    <div className="flex-1 overflow-y-auto bg-gray-50 rounded-xl border p-2 md:p-4">
                        {scoresList.length === 0 ? (
                            <div className="flex flex-col items-center justify-center h-full text-gray-500">
                                <i className="fa-solid fa-folder-open text-4xl mb-4 text-gray-300"></i>
                                <p className="font-bold">아직 평가가 완료된 학생이 없습니다.</p>
                            </div>
                        ) : (
                            <div className="grid grid-cols-1 gap-3">
                                {scoresList.map(([studentName, data], idx) => (
                                    <div key={idx} className="bg-white p-4 rounded-xl shadow-sm border border-gray-200 flex justify-between items-center hover:shadow-md transition">
                                        <div>
                                            <h3 className="font-bold text-lg text-gray-800">{studentName}</h3>
                                            <p className="text-sm text-gray-500 mt-1">평가 문제: {data.details.length}문항 중 <span className="font-bold text-green-600">{data.score}문항 정답</span></p>
                                        </div>
                                        <div className="flex items-center justify-center w-16 h-16 rounded-full bg-indigo-50 border-2 border-indigo-100">
                                            <span className="text-xl font-black text-indigo-600">{data.score}</span>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}
                    </div>
                </div>
            );
        }

        // ==========================================
        // 📋 교사: 평가 준비 화면
        // ==========================================
        function TestSetupScreen({ setScreen, setSelectedStudent, setTestQuestions, studentData }) {
            const [searchTerm, setSearchTerm] = useState('');
            const studentsList = Object.keys(studentData).map(key => ({ name: key, sentences: studentData[key] }));
            const filteredStudents = studentsList.filter(student => student.name.includes(searchTerm));

            const startTest = (student) => {
                setSelectedStudent(student.name);

                const shuffledStandard = [...standardSentences].sort(() => 0.5 - Math.random());
                const selectedStandard = shuffledStandard.slice(0, 4).map(q => ({ type: '기본(그림책)', ko: q.ko, jp: q.jp }));
                const storyQ = (student.sentences || []).slice(0, 4).map(s => ({ type: '창작(동화책)', ko: s.ko, jp: '' }));

                const needed = 4 - storyQ.length;
                let extraStandard = [];
                if (needed > 0) {
                    extraStandard = shuffledStandard.slice(4, 4 + needed).map(q => ({ type: '기본보충(그림책)', ko: q.ko, jp: q.jp }));
                }

                setTestQuestions([...selectedStandard, ...storyQ, ...extraStandard]);
                setScreen('test-running');
            };

            return (
                <div className="flex flex-col h-[80vh]">
                    <div className="flex justify-between items-center mb-6">
                        <button onClick={() => setScreen('teacher-menu')} className="text-gray-500 hover:text-gray-800"><i className="fa-solid fa-arrow-left text-xl"></i></button>
                        <h2 className="text-2xl font-bold text-gray-800">평가할 학생 선택</h2>
                        <div className="w-5"></div>
                    </div>
                    <div className="mb-4">
                        <input type="text" placeholder="학생 이름 또는 학번 검색..." value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} className="w-full border-2 border-gray-300 rounded-xl p-3 focus:border-gray-800 outline-none"/>
                    </div>
                    <div className="flex-1 overflow-y-auto bg-gray-50 rounded-xl border p-2">
                        {filteredStudents.length === 0 ? (
                            <p className="text-center text-gray-500 mt-10">제출한 학생이 없습니다.</p>
                        ) : (
                            filteredStudents.map((student, idx) => (
                                <div key={idx} className="bg-white p-4 rounded-lg shadow-sm mb-2 flex justify-between items-center border border-gray-100 hover:border-gray-300 transition">
                                    <div>
                                        <h3 className="font-bold text-lg text-gray-800">{student.name}</h3>
                                        <p className="text-sm text-gray-500">제출 문장 {student.sentences ? student.sentences.length : 0}개</p>
                                    </div>
                                    <button onClick={() => startTest(student)} className="bg-gray-800 hover:bg-gray-900 text-white font-bold py-2 px-4 rounded-lg text-sm shadow">평가 시작</button>
                                </div>
                            ))
                        )}
                    </div>
                </div>
            );
        }

        // ==========================================
        // 🔴 교사: 실시간 채점 화면 (✨ 녹음 기능 추가)
        // ==========================================
        function TestRunningScreen({ setScreen, studentName, testQuestions, setScore, testScores, setTestScores }) {
            const [currentQIndex, setCurrentQIndex] = useState(0);
            const [wordErrors, setWordErrors] = useState({}); 
            const [testResults, setTestResults] = useState([]); 
            
            // ★ 녹음 기능 관련 상태 변수들
            const [isRecording, setIsRecording] = useState(false);
            const [audioUrl, setAudioUrl] = useState(null);
            const mediaRecorderRef = useRef(null);
            const audioChunksRef = useRef([]);

            const q = testQuestions[currentQIndex];
            const words = q ? q.ko.split(/[\s/]+/).filter(w => w.trim() !== '') : [];

            // 문항이 넘어갈 때마다 단어 에러 상태와 녹음 내역을 초기화합니다.
            useEffect(() => {
                setWordErrors({});
                setAudioUrl(null);
                setIsRecording(false);
                if (mediaRecorderRef.current && mediaRecorderRef.current.state === "recording") {
                    mediaRecorderRef.current.stop();
                    mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop());
                }
            }, [currentQIndex]);

            const toggleWordError = (idx) => {
                setWordErrors({ ...wordErrors, [idx]: !wordErrors[idx] });
            };

            // ★ 녹음 시작 함수
            const startRecording = async () => {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorderRef.current = new MediaRecorder(stream);
                    audioChunksRef.current = [];

                    mediaRecorderRef.current.ondataavailable = (event) => {
                        if (event.data.size > 0) {
                            audioChunksRef.current.push(event.data);
                        }
                    };

                    mediaRecorderRef.current.onstop = () => {
                        const audioBlob = new Blob(audioChunksRef.current, { type: 'audio/webm' });
                        const url = URL.createObjectURL(audioBlob);
                        setAudioUrl(url);
                    };

                    mediaRecorderRef.current.start();
                    setIsRecording(true);
                    setAudioUrl(null);
                } catch (err) {
                    alert("마이크 접근 권한이 필요합니다. 브라우저 설정에서 마이크를 허용해주세요.");
                }
            };

            // ★ 녹음 중지 함수
            const stopRecording = () => {
                if (mediaRecorderRef.current && isRecording) {
                    mediaRecorderRef.current.stop();
                    setIsRecording(false);
                    mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop());
                }
            };

            const handleNext = (isCorrect) => {
                const newResult = { question: q, isCorrect: isCorrect, errors: wordErrors };
                const updatedResults = [...testResults, newResult];
                
                if (currentQIndex < testQuestions.length - 1) {
                    setTestResults(updatedResults);
                    setCurrentQIndex(currentQIndex + 1);
                } else {
                    const finalScore = updatedResults.filter(r => r.isCorrect).length;
                    const updatedScores = {
                        ...testScores,
                        [studentName]: { score: finalScore, details: updatedResults }
                    };
                    setTestScores(updatedScores);
                    setScore(finalScore);
                    setScreen('test-result');
                }
            };

            if (!q) return <div>문제 로딩중...</div>;

            return (
                <div className="flex flex-col h-full animate-fade-in">
                    <div className="flex justify-between items-center mb-4">
                        <h2 className="text-lg font-bold text-gray-700 bg-gray-200 px-3 py-1 rounded-md">{studentName} 평가 중</h2>
                        <span className="font-bold text-indigo-600 bg-indigo-100 px-3 py-1 rounded-md">{currentQIndex + 1} / {testQuestions.length}</span>
                    </div>
                    
                    <div className="flex-1 flex flex-col items-center py-4 overflow-y-auto">
                        <span className={`text-sm font-bold mb-4 px-3 py-1 rounded-full ${q.type.includes('기본') ? 'bg-blue-100 text-blue-700' : 'bg-pink-100 text-pink-700'}`}>
                            {q.type} 문장
                        </span>

                        {/* 한글 제시어 칸 */}
                        <div className="w-full bg-blue-50 border-2 border-blue-200 rounded-2xl p-6 md:p-8 mb-6 text-center shadow-sm relative">
                            <span className="absolute top-[-14px] left-1/2 transform -translate-x-1/2 bg-blue-600 text-white text-xs font-bold px-4 py-1 rounded-full shadow-sm">
                                <i className="fa-solid fa-comment-dots mr-1"></i> 학생 제시어 (한글)
                            </span>
                            <p className="text-2xl md:text-3xl font-black text-gray-900 break-keep-all leading-relaxed mt-2">{q.ko}</p>
                        </div>
                        
                        {/* ✨ 마이크 녹음기 UI 추가 부분 */}
                        <div className="w-full bg-gray-50 border border-gray-300 rounded-xl p-4 mb-4 flex flex-col items-center shadow-inner">
                            <h4 className="text-sm font-bold text-gray-500 mb-3"><i className="fa-solid fa-microphone-lines"></i> 학생 발음 실시간 녹음 (선택)</h4>
                            
                            <div className="flex items-center gap-4 h-12">
                                {!isRecording ? (
                                    <button onClick={startRecording} className="bg-red-500 hover:bg-red-600 text-white px-5 py-2.5 rounded-full font-bold shadow-md transition flex items-center gap-2">
                                        <i className="fa-solid fa-circle text-[0.6rem]"></i> 녹음 시작
                                    </button>
                                ) : (
                                    <button onClick={stopRecording} className="bg-gray-800 hover:bg-gray-900 text-white px-5 py-2.5 rounded-full font-bold shadow-md transition flex items-center gap-2 animate-pulse border-2 border-red-400">
                                        <i className="fa-solid fa-stop"></i> 중지하기
                                    </button>
                                )}
                                
                                {isRecording && <span className="text-red-500 font-bold animate-pulse text-sm">녹음 중...</span>}
                            </div>
                            
                            {/* 녹음이 완료되면 오디오 플레이어 노출 */}
                            {audioUrl && (
                                <div className="mt-4 w-full flex justify-center animate-fade-in">
                                    <audio controls src={audioUrl} className="h-10 w-full max-w-sm"></audio>
                                </div>
                            )}
                        </div>

                        {/* 채점 조작 패널 */}
                        <div className="w-full bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-gray-200 mb-4">
                            <h3 className="text-center text-gray-500 mb-6 text-sm font-bold"><i className="fa-solid fa-hand-pointer"></i> 틀리게 발음한 단어를 터치하세요. (빨간 줄 표시)</h3>
                            
                            <div className="flex flex-wrap justify-center gap-3 md:gap-4">
                                {words.map((word, idx) => (
                                    <button 
                                        key={idx}
                                        onClick={() => toggleWordError(idx)}
                                        className={`text-xl md:text-2xl font-black p-3 md:p-4 rounded-xl transition-all shadow-sm
                                            ${wordErrors[idx] ? 'bg-red-500 text-white line-through scale-95' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'}`}
                                    >
                                        {word}
                                    </button>
                                ))}
                            </div>

                            {q.jp && (
                                <div className="mt-8 pt-6 border-t border-gray-100 text-center bg-gray-50 rounded-xl p-4">
                                    <p className="text-gray-400 text-sm mb-2"><i className="fa-solid fa-eye-slash"></i> 교사용 일본어 정답 (학생에겐 비공개)</p>
                                    <p className="japanese-font text-indigo-700 font-bold text-lg break-keep-all">{q.jp}</p>
                                </div>
                            )}
                        </div>
                    </div>

                    <div className="grid grid-cols-2 gap-4 mt-auto pt-4 bg-gray-100 border-t border-gray-200">
                        <button onClick={() => handleNext(false)} className="bg-white hover:bg-red-50 text-red-600 font-bold py-5 rounded-xl text-xl shadow-sm transition border-2 border-red-200">
                            <i className="fa-solid fa-xmark mr-2 text-2xl"></i> 오답 (X)
                        </button>
                        <button onClick={() => handleNext(true)} className="bg-green-500 hover:bg-green-600 text-white font-bold py-5 rounded-xl text-xl shadow-md transition">
                            <i className="fa-solid fa-check mr-2 text-2xl"></i> 정답 (O)
                        </button>
                    </div>
                </div>
            );
        }

        // ==========================================
        // 🏁 교사: 채점 결과 완료 화면
        // ==========================================
        function TestResultScreen({ setScreen, studentName, testScores }) {
            const resultData = testScores[studentName];
            const score = resultData ? resultData.score : 0;
            const total = resultData ? resultData.details.length : 8;

            return (
                <div className="flex flex-col items-center justify-center py-10 h-full animate-fade-in text-center">
                    <div className="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mb-6 shadow-sm"><i className="fa-solid fa-clipboard-check text-5xl text-green-500"></i></div>
                    <h2 className="text-3xl font-black text-gray-800 mb-2">평가 완료!</h2>
                    <p className="text-xl text-gray-600 mb-8 font-bold">{studentName} 학생</p>
                    <div className="bg-gray-50 border-2 border-dashed border-gray-300 w-full max-w-sm rounded-2xl p-8 mb-8">
                        <p className="text-gray-500 font-bold mb-2">최종 점수</p>
                        <div className="text-6xl font-black text-indigo-600">{score} <span className="text-2xl text-gray-400">/ {total}</span></div>
                    </div>
                    <div className="flex gap-4 w-full max-w-sm">
                        <button onClick={() => setScreen('test-setup')} className="flex-1 bg-gray-800 hover:bg-gray-900 text-white font-bold py-4 rounded-xl shadow transition">다음 학생 평가</button>
                        <button onClick={() => setScreen('teacher-menu')} className="flex-1 bg-white border-2 border-gray-300 text-gray-700 hover:bg-gray-50 font-bold py-4 rounded-xl shadow-sm transition">메뉴로</button>
                    </div>
                </div>
            );
        }

        // ==========================================
        // 🚀 메인 App 컴포넌트
        // ==========================================
        function App() {
            const [screen, setScreen] = useState('home'); 
            const [studentData, setStudentData] = useState({});
            const [selectedStudent, setSelectedStudent] = useState('');
            const [testQuestions, setTestQuestions] = useState([]);
            const [score, setScore] = useState(0);
            const [testScores, setTestScores] = useState({});

            // ★ 서버(GAS) 명단 데이터를 불러오는 로직
            useEffect(() => {
                try {
                    // 구글 앱스 스크립트에서 주입해주는 데이터를 파싱
                    const serverData = JSON.parse('<?= typeof serverStudentList !== "undefined" ? serverStudentList : "[]" ?>');
                    if (serverData && serverData.length > 0) {
                        const tempStudentObj = {};
                        serverData.forEach(student => {
                            tempStudentObj[student.fullName] = [];
                        });
                        setStudentData(tempStudentObj);
                    } else {
                        // 데모용 가짜 데이터
                        setStudentData({
                            "1반 10101 홍길동": [{ ko: "사과로 무엇 만들어? / 잼을 만들어." }],
                            "2반 20202 김철수": [{ ko: "눈으로 무엇 만들어? / 눈사람 만들어." }]
                        });
                    }
                } catch (e) {
                    console.log("명단 로드 실패, 기본 데이터 사용");
                    setStudentData({
                        "1반 10101 홍길동": [{ ko: "사과로 무엇 만들어? / 잼을 만들어." }]
                    });
                }
            }, []);

            const renderScreen = () => {
                switch(screen) {
                    case 'home': return <HomeScreen setScreen={setScreen} />;
                    case 'practice': return <PracticeScreen setScreen={setScreen} studentData={studentData} />;
                    case 'student-submit': return <StudentSubmitScreen setScreen={setScreen} studentData={studentData} setStudentData={setStudentData} />;
                    case 'student-result': return <StudentResultScreen setScreen={setScreen} testScores={testScores} />;
                    case 'teacher-login': return <TeacherLoginScreen setScreen={setScreen} />;
                    case 'teacher-menu': return <TeacherMenuScreen setScreen={setScreen} />;
                    case 'teacher-dashboard': return <TeacherDashboardScreen setScreen={setScreen} testScores={testScores} />;
                    case 'test-setup': return <TestSetupScreen setScreen={setScreen} setSelectedStudent={setSelectedStudent} setTestQuestions={setTestQuestions} studentData={studentData} />;
                    case 'test-running': return <TestRunningScreen setScreen={setScreen} studentName={selectedStudent} testQuestions={testQuestions} setScore={setScore} testScores={testScores} setTestScores={setTestScores} />;
                    case 'test-result': return <TestResultScreen setScreen={setScreen} studentName={selectedStudent} testScores={testScores} />;
                    default: return <HomeScreen setScreen={setScreen} />;
                }
            };

            return (
                <div className="min-h-screen bg-gray-100 py-8 px-4 sm:px-8 flex justify-center font-sans">
                    <div className="w-full max-w-5xl bg-white rounded-2xl shadow-xl overflow-hidden flex flex-col min-h-[80vh] border border-gray-200">
                        <div className="bg-indigo-600 text-white py-4 px-6 flex justify-between items-center shadow-md">
                            <h1 className="text-xl font-bold flex items-center gap-2">
                                <i className="fa-solid fa-book-open"></i> 일본어 회화 프로젝트
                            </h1>
                            <div className="text-indigo-200 text-sm font-medium">수행평가 시스템</div>
                        </div>
                        <div className="flex-1 overflow-y-auto p-4 md:p-10">
                            {renderScreen()}
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
